rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ MODO DESARROLLO — acceso abierto
    // Antes de pasar a producción, reemplazar por reglas con autenticación
    match /{document=**} {
      allow read, write: if true;
    }

    // --- Reglas sugeridas para producción (con Firebase Auth) ---
    // match /clientes/{id}   { allow read, write: if request.auth != null; }
    // match /ventas/{id}     { allow read, write: if request.auth != null; }
    // match /pagos/{id}      { allow read, write: if request.auth != null; }
    // match /compras/{id}    { allow read, write: if request.auth != null; }
    // match /egresos/{id}    { allow read, write: if request.auth != null; }
  }
}
